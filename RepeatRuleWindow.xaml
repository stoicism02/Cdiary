<Window x:Class="Cdiary.RepeatRuleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="设置重复" Width="445" Height="575"
        MinWidth="445" MinHeight="575" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8F8F0" FontFamily="Microsoft YaHei UI" Foreground="#725D42">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#FFFBE7"/><Setter Property="BorderBrush" Value="#C4B89E"/>
            <Setter Property="BorderThickness" Value="1.5"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                    <ScrollViewer x:Name="PART_ContentHost"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#19C8B9"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#DDF7F1"/><Setter Property="Foreground" Value="#0D9F94"/>
            <Setter Property="BorderBrush" Value="#19C8B9"/><Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="15,8"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <Border Background="{TemplateBinding BorderBrush}" CornerRadius="15" Margin="0,3,0,0"/>
                    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15" Padding="{TemplateBinding Padding}" Margin="0,0,0,3">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Margin" Value="0,3,0,0"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="Chip" Width="38" Height="32" Background="#FFFBE7" BorderBrush="#D8CBB3" BorderThickness="1.5" CornerRadius="12">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#19C8B9"/><Setter TargetName="Chip" Property="BorderBrush" Value="#0D9F94"/><Setter Property="Foreground" Value="White"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Margin="18" Padding="22" Background="#F7F3DF" CornerRadius="24">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="让任务按时回来  ✿" FontSize="21" FontWeight="Bold" Foreground="#794F27"/>
                <TextBlock Text="每天会生成独立任务；完成状态和笔记互不影响。" FontSize="11" Foreground="#9F927D" Margin="0,5,0,0"/></StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,0">
                <RadioButton x:Name="DailyRadio" Content="每天" IsChecked="True" GroupName="Frequency" Checked="FrequencyChanged" Margin="0,0,20,0"/>
                <RadioButton x:Name="WeeklyRadio" Content="每周指定日期" GroupName="Frequency" Checked="FrequencyChanged"/>
            </StackPanel>
            <StackPanel x:Name="WeekdaysPanel" Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0" IsEnabled="False">
                <CheckBox x:Name="Monday" Content="一"/><CheckBox x:Name="Tuesday" Content="二"/>
                <CheckBox x:Name="Wednesday" Content="三"/><CheckBox x:Name="Thursday" Content="四"/>
                <CheckBox x:Name="Friday" Content="五"/><CheckBox x:Name="Saturday" Content="六"/>
                <CheckBox x:Name="Sunday" Content="日" Margin="0"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,19,0,0"><TextBlock Text="后续任务标题" FontSize="12" FontWeight="Bold"/>
                <TextBox x:Name="TitleBox" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Grid.Row="4" Margin="0,15,0,0"><TextBlock Text="提醒时间（可留空）" FontSize="12" FontWeight="Bold"/>
                <TextBox x:Name="ReminderBox" Margin="0,6,0,0" ToolTip="例如 14:30"/></StackPanel>
            <StackPanel Grid.Row="5" Margin="0,15,0,0"><TextBlock Text="后续任务的初始笔记" FontSize="12" FontWeight="Bold"/>
                <TextBox x:Name="NoteBox" Margin="0,6,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="80"/></StackPanel>
            <Grid Grid.Row="6" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="StopButton" Content="停止重复" HorizontalAlignment="Left" Click="Stop_Click" Foreground="#AF5C53" Background="#FFF1E8" BorderBrush="#DDA99C"/>
                <Button Grid.Column="1" Content="取消" Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="保存规则" Click="Save_Click" Background="#19C8B9" Foreground="White" BorderBrush="#0D9F94"/>
            </Grid>
        </Grid>
    </Border>
</Window>
