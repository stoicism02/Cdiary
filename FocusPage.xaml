<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Cdiary" x:Class="Cdiary.FocusPage" SizeChanged="Resize" Foreground="#263D38" FontFamily="Microsoft YaHei UI" FontSize="13">
 <UserControl.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Cdiary;component/Styles/LightIsland.xaml"/></ResourceDictionary.MergedDictionaries><Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="2,3"/>
            <Setter Property="Foreground" Value="#263D38"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Item" Background="#FFFFFF" BorderBrush="#D7E2DC" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" HorizontalAlignment="Stretch"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#E6F2ED"/><Setter TargetName="Item" Property="BorderBrush" Value="#19C8B9"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#E6F2ED"/><Setter TargetName="Item" Property="BorderBrush" Value="#19C8B9"/><Setter Property="Foreground" Value="#0D9F94"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="11"/><Setter Property="Background" Value="#E6F2ED"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="1,0">
                    <Track x:Name="PART_Track" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}" IsDirectionReversed="True" Margin="1">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                            <Border Background="#19C8B9" CornerRadius="4"/>
                        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="IsEditable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border x:Name="Frame" Background="#FFFFFF" BorderBrush="#D7E2DC" BorderThickness="1" CornerRadius="6">
                        <Grid Margin="10,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Grid.Column="1" Text="⌄" FontSize="15" Foreground="#60736C" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ToggleButton x:Name="DropDownToggle" Focusable="False" Background="Transparent" BorderThickness="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Placement="Bottom" AllowsTransparency="True" Focusable="False" StaysOpen="False" PopupAnimation="Fade">
                        <Border Background="#F2F7F5" BorderBrush="#D7E2DC" BorderThickness="1" CornerRadius="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="236" Padding="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#19C8B9"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FocusShareBar" TargetType="ProgressBar">
         <Setter Property="Height" Value="6"/><Setter Property="Background" Value="#EBE3CD"/>
         <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FocusModeTab" TargetType="RadioButton"><Setter Property="Padding" Value="14,7"/><Setter Property="Foreground" Value="#263D38"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tab" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="#DDF5ED"/><Setter Property="Foreground" Value="#177A70"/><Setter Property="FontWeight" Value="Bold"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="#217D6F"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </ResourceDictionary></UserControl.Resources>
 <Border Background="#FFFFFF" CornerRadius="0" Padding="16,16" BorderThickness="0">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
  <DockPanel><TextBlock x:Name="DateCaption" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><TextBlock Text="专注" FontSize="24" FontWeight="Bold"/></DockPanel>
  <TextBlock Text="今天，慢慢做好手头这一件事。" Foreground="{DynamicResource Muted}" Margin="0,6,0,20"/>
  <Border Height="1" Background="#D7E2DC" Margin="0,0,0,18"/>
  <Grid x:Name="TopLayout"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="284"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border x:Name="TimerCard" Background="#EAF2EE" CornerRadius="6" Padding="20" MinHeight="324">
    <StackPanel>
     <ComboBox x:Name="ModePicker" Visibility="Collapsed" SelectedIndex="0"><ComboBoxItem Content="番茄钟"/><ComboBoxItem Content="正计时"/></ComboBox>
     <WrapPanel x:Name="SetupRow" HorizontalAlignment="Left"><Border Background="#FFFFFF" BorderBrush="#D7E2DC" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><RadioButton x:Name="PomodoroTab" Content="番茄钟" Style="{StaticResource FocusModeTab}"/><RadioButton x:Name="StopwatchTab" Content="正计时" Style="{StaticResource FocusModeTab}"/></StackPanel></Border><ComboBox x:Name="MinutesPicker" Width="72" Margin="0,0,0,8" ToolTip="每轮专注分钟数"/></WrapPanel>
     <DockPanel x:Name="SessionHeader" Margin="0,0,0,16"><TextBlock x:Name="SessionRound" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/><TextBlock x:Name="SessionMode" Foreground="#177A70" FontWeight="Bold"/></DockPanel>
     <ComboBox x:Name="TaskPicker" MaxWidth="370" Margin="0,8" ToolTip="选择要专注的任务" HorizontalContentAlignment="Stretch">
      <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Foreground="#263D38"/></DataTemplate></ComboBox.ItemTemplate>
     </ComboBox>
     <TextBlock x:Name="CurrentTitle" TextWrapping="Wrap" TextAlignment="Center" FontSize="19" FontWeight="Bold" Margin="0,12,0,0"/>
     <TextBlock x:Name="ClockText" Text="25:00" FontSize="60" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12" Typography.NumeralAlignment="Tabular"/>
     <ProgressBar x:Name="RoundProgress" Width="200" Maximum="100" Foreground="#70C5AE" Style="{StaticResource FocusShareBar}" Margin="0,0,0,10" Visibility="Collapsed" ToolTip="当前番茄钟这一轮的进度"/><TextBlock x:Name="StateText" TextAlignment="Center" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
     <WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0"><Button x:Name="StartButton" Content="开始专注" Click="StartClick" Style="{DynamicResource PrimaryPill}" MinWidth="100" Margin="4"/><Button x:Name="PauseButton" Content="暂停" Click="PauseClick" Style="{DynamicResource PrimaryPill}" MinWidth="100" Margin="4"/><Button x:Name="EndButton" Content="结束" Click="EndClick" Style="{DynamicResource Pill}" MinWidth="100" Margin="4"/><Button x:Name="BreakButton" Content="开始休息" Click="BreakClick" Style="{DynamicResource Pill}" Margin="4"/></WrapPanel>
    </StackPanel>
   </Border>
   <StackPanel x:Name="Summary" Grid.Column="1" Margin="24,8,0,0" MaxWidth="260" HorizontalAlignment="Left">
    <TextBlock Text="今日投入" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="TodayTotal" FontSize="28" FontWeight="Bold" Margin="0,12"/><TextBlock x:Name="RoundText" Foreground="{DynamicResource Muted}"/>
    <Border Height="1" Background="#D7E2DC" Margin="0,24,0,18"/>
    <Grid x:Name="DistributionBar" Width="240" Height="8" Margin="0,0,0,20" Visibility="Collapsed" ToolTip="各任务占今日专注总时长的比例"><Grid.Clip><RectangleGeometry Rect="0,0,240,8" RadiusX="4" RadiusY="4"/></Grid.Clip></Grid>
    <ItemsControl x:Name="Totals" Width="240" MaxWidth="240"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{Binding Color}" Margin="0,0,7,0" Visibility="{Binding ShareVisibility}"/><TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Margin="0,0,10,0" VerticalAlignment="Center"/><StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Time}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/><TextBlock Text="{Binding ShareText}" Visibility="{Binding ShareVisibility}" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="ProgressHint" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
   </StackPanel>
  </Grid>
  <TextBlock x:Name="ErrorText" Foreground="#B35043" TextWrapping="Wrap" Margin="0,10"/>
  <DockPanel Margin="0,15,0,12"><TextBlock Text="专注记录" FontSize="18" FontWeight="Bold"/><ComboBox x:Name="HistoryFilter" Width="105" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="今天"/><ComboBoxItem Content="最近 7 天"/><ComboBoxItem Content="全部"/></ComboBox></DockPanel>
  <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="时间" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="1" Text="任务" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="2" Text="投入" Foreground="{DynamicResource Muted}"/><TextBlock Grid.Column="3" Text="结果" Foreground="{DynamicResource Muted}"/></Grid>
  <ItemsControl x:Name="History"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#D7E2DC" BorderThickness="0,0,0,1" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Period}" FontSize="12" ToolTip="{Binding Detail}"/><TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Margin="0,0,12,0"/><TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="12"/><TextBlock Grid.Column="3" Text="{Binding Result}" FontSize="12" Foreground="{Binding Color}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <TextBlock x:Name="EmptyText" Text="还没有专注记录，选一个任务开始吧。" Foreground="{DynamicResource Muted}" Margin="0,12"/>
  <Button x:Name="MoreButton" Content="显示更多" Click="MoreClick" Style="{DynamicResource Pill}" HorizontalAlignment="Center" Margin="0,12"/>
  <Expander Header="专注设置" Margin="0,20,0,0"><StackPanel Margin="0,12"><WrapPanel><StackPanel Margin="0,0,14,10"><TextBlock Text="专注分钟"/><ComboBox x:Name="WorkSetting" Width="90"/></StackPanel><StackPanel Margin="0,0,14,10"><TextBlock Text="短休息分钟"/><ComboBox x:Name="ShortSetting" Width="90"/></StackPanel><StackPanel Margin="0,0,14,10"><TextBlock Text="长休息分钟"/><ComboBox x:Name="LongSetting" Width="90"/></StackPanel><StackPanel Margin="0,0,14,10"><TextBlock Text="长休息间隔（轮）"/><ComboBox x:Name="RoundsSetting" Width="100"/></StackPanel></WrapPanel><CheckBox x:Name="SoundSetting" Content="到时播放提示音" Margin="0,8"/><Button Content="保存专注设置" Click="SaveSettingsClick" Style="{DynamicResource Pill}" HorizontalAlignment="Left"/></StackPanel></Expander>
 </StackPanel></ScrollViewer></Border>
</UserControl>
