<UserControl x:Class="Cdiary.ScreenshotPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Microsoft YaHei UI" Foreground="#725D42">
    <Border Background="#F7F3DF" CornerRadius="24" Padding="25,22">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="＋ 截一张" Style="{DynamicResource PrimaryPill}" Click="Capture_Click"/>
                <StackPanel><TextBlock Text="截图箱" FontSize="23" FontWeight="Bold" Foreground="#794F27"/>
                    <TextBlock x:Name="Summary" Text="把刚才看到的，暂时收在这里。" TextWrapping="Wrap" FontSize="12" Foreground="#9F927D" Margin="0,5,0,0"/></StackPanel>
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,17,0,10">
                <Button DockPanel.Dock="Right" Content="清理与快捷键设置" Style="{DynamicResource Pill}" Padding="13,7" Click="Settings_Click"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="全选" Style="{DynamicResource Pill}" Padding="12,7" Click="SelectAll_Click" Margin="0,0,7,0"/>
                    <Button x:Name="CopyButton" Content="复制" Style="{DynamicResource Pill}" Padding="12,7" Click="Copy_Click" IsEnabled="False" Margin="0,0,7,0"/>
                    <Button x:Name="ExportButton" Content="另存为" Style="{DynamicResource Pill}" Padding="12,7" Click="Export_Click" IsEnabled="False" Margin="0,0,7,0"/>
                    <Button x:Name="DeleteButton" Content="删除" Style="{DynamicResource DangerPill}" Padding="12,7" Click="Delete_Click" IsEnabled="False"/>
                </StackPanel>
            </DockPanel>
            <Border x:Name="DeletePrompt" Grid.Row="2" Visibility="Collapsed" Background="#FFF1E8" CornerRadius="12" Padding="12,8" Margin="0,0,0,8">
                <DockPanel><Button Content="确认删除" DockPanel.Dock="Right" Style="{DynamicResource DangerPill}" Padding="12,6" Click="ConfirmDelete_Click"/>
                    <Button Content="取消" DockPanel.Dock="Right" Style="{DynamicResource Pill}" Padding="12,6" Margin="0,0,8,0" Click="CancelDelete_Click"/>
                    <TextBlock x:Name="DeleteText" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"/></DockPanel>
            </Border>
            <Grid Grid.Row="3">
                <ListBox x:Name="Rows" BorderThickness="0" Background="Transparent" Foreground="#725D42" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         PreviewKeyDown="Gallery_KeyDown" SizeChanged="Rows_SizeChanged">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Header}" FontSize="13" FontWeight="Bold" Margin="3,5,0,9">
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Header}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Background="#FFFBE7" BorderBrush="#E5DCC7" BorderThickness="1.5" CornerRadius="17" Padding="10" Margin="0,0,10,0"
                                            MouseLeftButtonDown="Card_MouseDown" ToolTip="{Binding ExpiryLabel}">
                                        <StackPanel>
                                            <Border Height="120" SizeChanged="ThumbnailFrame_SizeChanged" Background="#F0E8D8" CornerRadius="10" ClipToBounds="True">
                                                <Image Tag="{Binding ThumbnailPath, NotifyOnTargetUpdated=True}" TargetUpdated="Thumbnail_Loaded" Loaded="Thumbnail_Loaded" Unloaded="Thumbnail_Unloaded" Stretch="Uniform"/>
                                            </Border>
                                            <DockPanel Margin="1,10,0,0">
                                                <CheckBox DockPanel.Dock="Right" Style="{DynamicResource IslandCheck}" Tag="{Binding Id, NotifyOnTargetUpdated=True}" TargetUpdated="Selection_Loaded" Click="Selection_Click" Loaded="Selection_Loaded" ToolTip="选择图片"/>
                                                <TextBlock Text="{Binding TimeLabel}" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Details}" FontSize="11" Foreground="#9F927D" Margin="1,5,0,0"/>
                                            <TextBlock Text="{Binding ExpiryLabel}" FontSize="10" Foreground="#9F927D" Margin="1,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border Background="#DDF7F1" CornerRadius="24" Width="86" Height="75" HorizontalAlignment="Center">
                        <Path Data="M 2,8 L 8,8 L 11,3 L 23,3 L 26,8 L 32,8 L 32,27 L 2,27 Z M 23,17 A 6,6 0 1 1 11,17 A 6,6 0 1 1 23,17"
                              Stroke="#0D9F94" StrokeThickness="2" Width="34" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="还没有暂存的截图" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,8"/>
                    <TextBlock x:Name="EmptyHint" Text="点击“截一张”，框选想留下的画面" FontSize="12" Foreground="#9F927D" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="Status" Grid.Row="4" Text="双击看原图；Ctrl / Shift 可多选。重要的图片记得另存为。" FontSize="11" Foreground="#9F927D" TextWrapping="Wrap" Margin="2,8,0,0"/>
        </Grid>
    </Border>
</UserControl>
