<Window x:Class="Cdiary.TaskNoteWindow" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Cdiary"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="任务便签" Icon="/Cdiary;component/Assets/Cdiary.ico" Width="340" Height="400" MinWidth="260" MinHeight="260"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="True" Background="{DynamicResource WindowSurface}" FontFamily="Microsoft YaHei UI"
        FontSize="14" Foreground="{DynamicResource TextInk}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:LiveStyleDictionary/>
            </ResourceDictionary.MergedDictionaries>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Background" Value="#F0E8D8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,0">
                    <Track x:Name="PART_Track" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"
                           IsDirectionReversed="True" Margin="1">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb>
                            <Thumb.Template><ControlTemplate TargetType="Thumb">
                                <Border Background="{DynamicResource Accent}" BorderBrush="#11A89B" BorderThickness="0,0,2,0" CornerRadius="7">
                                    <Border Width="3" Margin="3,5,0,5" Background="#7EE4DB" CornerRadius="2" HorizontalAlignment="Left"/>
                                </Border>
                            </ControlTemplate></Thumb.Template></Thumb>
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="13,7,13,13" SizeChanged="Content_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="51"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="11" Background="{DynamicResource Accent}" Margin="0,0,9,0">
                    <TextBlock Text="✿" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="任务便签" Style="{DynamicResource NoteTitle}"/>
                    <TextBlock Text="随手记，随时看" FontSize="10" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
            </StackPanel>
            <ToggleButton x:Name="PinToggle" Grid.Column="1" Style="{DynamicResource PinToggle}" Margin="0,0,7,0"
                          IsChecked="{Binding Topmost, ElementName=Root, Mode=TwoWay}"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Grid.Column="2" Content="×" Style="{DynamicResource NoteCloseButton}"

                    Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>
        <Border Grid.Row="1" Height="1" Background="#DED2BC" Margin="0,0,0,12"/>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBox x:Name="TitleEditor" Grid.Row="0" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Style="{DynamicResource NoteInput}" FontWeight="Bold" Margin="0,0,0,10" ToolTip="任务名称"
                     TextWrapping="Wrap" MaxHeight="72" VerticalScrollBarVisibility="Auto"/>
            <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><local:FocusBar x:Name="NoteFocus" Visibility="Collapsed"/><local:MarkdownNoteView x:Name="NoteEditor" Grid.Row="1" Task="{Binding}"/></Grid>
            <TextBlock x:Name="SaveHint" Grid.Row="2" Text="自动保存 · 拖动顶部可移动" Foreground="{DynamicResource Muted}" FontSize="10" Margin="3,9,0,0"/>
        </Grid>
    </Grid>
</Window>
