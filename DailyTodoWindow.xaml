<Window x:Class="Cdiary.DailyTodoWindow" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Cdiary"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="当日待办" Icon="/Cdiary;component/Assets/Cdiary.ico" Width="365" Height="480" MinWidth="285" MinHeight="290"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="True" Background="{DynamicResource WindowSurface}" FontFamily="Microsoft YaHei UI"
        FontSize="14" Foreground="{DynamicResource TextInk}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="59" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:LiveStyleDictionary/>
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="TodoRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Width" Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
            <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Background="{DynamicResource PaperSurface}" BorderBrush="#E5DCC7" BorderThickness="1.5"
                        CornerRadius="17" Padding="12,11"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E6F9F6"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TodoCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="CheckScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                    <Border x:Name="Box" Background="{DynamicResource PaperSurface}" BorderBrush="{DynamicResource Muted}" BorderThickness="2" CornerRadius="8"/>
                    <Path x:Name="Tick" Data="M 5 12 L 10 17 L 20 7" Stroke="White" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentOutline}"/>
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To="0.8" Duration="0:0:0.08"/>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="0:0:0.08"/>
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Style.Triggers><Trigger Property="Orientation" Value="Vertical">
            <Setter Property="Width" Value="16"/><Setter Property="Background" Value="#F0E8D8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,0">
                    <Track x:Name="PART_Track" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"
                           IsDirectionReversed="True" Margin="1">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                            <Border Background="{DynamicResource Accent}" BorderBrush="#11A89B" BorderThickness="0,0,2,0" CornerRadius="7">
                                <Border Width="3" Margin="3,5,0,5" Background="#7EE4DB" CornerRadius="2" HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            </Trigger></Style.Triggers>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="14,7,14,13">
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="11" Background="{DynamicResource Accent}" Margin="0,0,9,0">
                    <TextBlock Text="✿" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="当日待办" Style="{DynamicResource NoteTitle}"/>
                    <TextBlock Text="双击任务打开专属便签" TextTrimming="CharacterEllipsis" FontSize="10" Foreground="{DynamicResource Muted}"/>
                </StackPanel>
            </Grid>
            <ToggleButton x:Name="PinToggle" Grid.Column="1" Style="{DynamicResource PinToggle}" Margin="0,0,7,0"
                          IsChecked="{Binding Topmost, ElementName=Root, Mode=TwoWay}"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Grid.Column="2" Content="×" Style="{DynamicResource NoteCloseButton}"

                    Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>
        <Grid Grid.Row="1" Margin="2,13,2,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding DayLabel}" FontSize="20" TextTrimming="CharacterEllipsis" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                <TextBlock Text="这一天的任务" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E6F9F6" CornerRadius="14" Padding="9,5" VerticalAlignment="Center">
                <TextBlock Text="{Binding ProgressLabel}" Foreground="{DynamicResource AccentOutline}" FontSize="11" FontWeight="Bold"/>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource Card}" CornerRadius="21" Padding="12">
            <Grid>
                <ListBox x:Name="TodoList" ItemsSource="{Binding ActiveTasks}" ItemContainerStyle="{StaticResource TodoRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.ScrollChanged="TodoList_ScrollChanged"
                         Background="Transparent" BorderThickness="0" MouseDoubleClick="TodoList_MouseDoubleClick">
                <ListBox.ItemTemplate><DataTemplate><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" Style="{StaticResource TodoCheck}"
                              VerticalAlignment="Center" Click="TaskCheck_Click"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" Margin="0,0,8,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                            </DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding ReminderLabel}" Foreground="{DynamicResource Muted}"
                               FontSize="11" VerticalAlignment="Center"/>
                </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="今天的待办已清空&#10;完成的任务可在主界面查看" TextAlignment="Center"
                           Foreground="{DynamicResource Muted}" FontSize="12" LineHeight="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding HasTasks}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <TextBlock Grid.Row="3" Text="勾选完成 · 双击任务写笔记" Foreground="{DynamicResource Muted}"
                   FontSize="10" Margin="3,10,0,0"/>
    </Grid>
</Window>
