<Window x:Class="Cdiary.DailyTodoWindow" x:Name="Root" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="当日待办" Width="365" Height="480" MinWidth="285" MinHeight="290"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="True" Background="#F8F8F0" FontFamily="Microsoft YaHei UI"
        FontSize="14" Foreground="#725D42">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="59" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="PinToggleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="NoteButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFBE7"/><Setter Property="Foreground" Value="#794F27"/>
            <Setter Property="BorderBrush" Value="#C4B89E"/><Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="10,5"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid>
                    <Border Background="{TemplateBinding BorderBrush}" CornerRadius="16" Margin="0,3,0,0"/>
                    <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16"
                            Padding="{TemplateBinding Padding}" Margin="0,0,0,3" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Face" Property="Margin" Value="0,3,0,0"/>
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.08"/>
                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08"/>
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TodoRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Background="#FFFBE7" BorderBrush="#E5DCC7" BorderThickness="1.5"
                        CornerRadius="17" Padding="12,11"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#19C8B9"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E6F9F6"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TodoCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="CheckScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                    <Border x:Name="Box" Background="#FFFBE7" BorderBrush="#9F927D" BorderThickness="2" CornerRadius="8"/>
                    <Path x:Name="Tick" Data="M 5 12 L 10 17 L 20 7" Stroke="White" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="#19C8B9"/>
                        <Setter TargetName="Box" Property="BorderBrush" Value="#0D9F94"/>
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To="0.8" Duration="0:0:0.08"/>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="0:0:0.08"/>
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="16"/><Setter Property="Background" Value="#F0E8D8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,0">
                    <Track x:Name="PART_Track" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"
                           IsDirectionReversed="True" Margin="1">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                            <Border Background="#19C8B9" BorderBrush="#11A89B" BorderThickness="0,0,2,0" CornerRadius="7">
                                <Border Width="3" Margin="3,5,0,5" Background="#7EE4DB" CornerRadius="2" HorizontalAlignment="Left"/>
                            </Border>
                        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="14,7,14,13">
        <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="32" Height="32" CornerRadius="11" Background="#19C8B9" Margin="0,0,9,0">
                    <TextBlock Text="✿" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="当日待办" FontWeight="Bold" FontSize="16" Foreground="#794F27"/>
                    <TextBlock Text="双击任务打开专属便签" FontSize="10" Foreground="#9F927D"/>
                </StackPanel>
            </StackPanel>
            <ToggleButton x:Name="PinToggle" Grid.Column="1" Style="{StaticResource PinToggle}" Margin="0,0,7,0"
                          IsChecked="{Binding Topmost, ElementName=Root, Mode=TwoWay}"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Grid.Column="2" Content="×" Style="{StaticResource NoteButton}" Foreground="#AF5C53"
                    Width="30" Padding="0" FontSize="18" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>
        <Grid Grid.Row="1" Margin="2,13,2,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding DayLabel}" FontSize="20" FontWeight="Bold" Foreground="#794F27"/>
                <TextBlock Text="这一天的任务" Foreground="#9F927D" FontSize="11" Margin="0,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#E6F9F6" CornerRadius="14" Padding="9,5" VerticalAlignment="Center">
                <TextBlock Text="{Binding ProgressLabel}" Foreground="#0D9F94" FontSize="11" FontWeight="Bold"/>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#F7F3DF" CornerRadius="21" Padding="12">
            <Grid>
                <ListBox x:Name="TodoList" ItemsSource="{Binding Tasks}" ItemContainerStyle="{StaticResource TodoRow}"
                         Background="Transparent" BorderThickness="0" MouseDoubleClick="TodoList_MouseDoubleClick">
                <ListBox.ItemTemplate><DataTemplate><Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" Style="{StaticResource TodoCheck}"
                              VerticalAlignment="Center" Click="TaskCheck_Click"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                <Setter Property="Foreground" Value="#9F927D"/>
                            </DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="{Binding ReminderLabel}" Foreground="#9F927D"
                               FontSize="11" VerticalAlignment="Center"/>
                </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="这一天还没有任务&#10;去主界面添加第一件事吧" TextAlignment="Center"
                           Foreground="#9F927D" FontSize="12" LineHeight="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers><DataTrigger Binding="{Binding HasTasks}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <TextBlock Grid.Row="3" Text="勾选完成 · 双击任务写笔记" Foreground="#9F927D"
                   FontSize="10" Margin="3,10,0,0"/>
    </Grid>
</Window>
