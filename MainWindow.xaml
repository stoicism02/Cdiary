<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:Cdiary" x:Class="Cdiary.MainWindow" Title="小岛日记" Icon="/Cdiary;component/Assets/Cdiary.ico" Width="1100" Height="720" MinWidth="760" MinHeight="580" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowSurface}" FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="{DynamicResource TextInk}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="82" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="/Cdiary;component/Styles/LightIsland.xaml"/></ResourceDictionary.MergedDictionaries>
        <local:CalendarGridHeightConverter x:Key="CalendarGridHeight"/>

        <Style x:Key="RailTab" TargetType="RadioButton">
 <Setter Property="Height" Value="42"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="14"/>
 <Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Tile" Background="Transparent" CornerRadius="6" Padding="14,8" BorderBrush="Transparent" BorderThickness="3,0,0,0"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
 <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource WindowSurface}"/></Trigger>
 <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectedSurface}"/><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
 </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="CompletedFilter" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#60736C"/>
            <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Chip" Background="{DynamicResource PaperSurface}" BorderBrush="#D7E2DC" BorderThickness="1" CornerRadius="6" Padding="14,8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#E6F2ED"/>
                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentOutline}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CalendarTaskChip" TargetType="Button">
            <Setter Property="Background" Value="#E7F0F2"/><Setter Property="Foreground" Value="#526F7A"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,0,3"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chip" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Done"><Setter Property="Background" Value="#DDF7E9"/><Setter Property="Foreground" Value="#397457"/></DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Today"><Setter Property="Background" Value="#FFF0D3"/><Setter Property="Foreground" Value="#946421"/></DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Progress"><Setter Property="Background" Value="#DDF3EE"/><Setter Property="Foreground" Value="#237A71"/></DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Overdue"><Setter Property="Background" Value="#FBE2DD"/><Setter Property="Foreground" Value="#A34F45"/></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Opacity" Value="0.75"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="DayRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="11,8"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E6F2ED"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TaskRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Background="Transparent" BorderBrush="#D7E2DC" BorderThickness="0,0,0,1" CornerRadius="0" Padding="8,8" MinHeight="52"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E6F2ED"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OverdueRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border Background="Transparent" BorderBrush="#D7E2DC" BorderThickness="0,0,0,1" CornerRadius="0" Padding="8,8" MinHeight="40"><ContentPresenter/></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OverdueLink" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextInk}"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentOutline}"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IslandCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Width="20" Height="20" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="CheckScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                    <Border x:Name="Box" Background="{DynamicResource PaperSurface}" BorderBrush="{DynamicResource Muted}" BorderThickness="1" CornerRadius="5"/>
                    <Path x:Name="Tick" Data="M 4 10 L 8 14 L 16 6" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentOutline}"/>
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To="0.8" Duration="0:0:0.08"/>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="0:0:0.08"/>
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        </ResourceDictionary></Window.Resources>
    <Grid x:Name="LayoutRoot" Background="{DynamicResource WindowSurface}" Margin="0" SizeChanged="LayoutRoot_SizeChanged">
        <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="18,0,16,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="30" Height="30" Background="{DynamicResource Accent}" CornerRadius="8" Margin="0,0,9,0">
                    <TextBlock Text="✿" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AppHeading" Text="小岛日记" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    <TextBlock x:Name="BrandSubtitle" Text="把日子理清" Foreground="{DynamicResource Muted}" FontSize="11" Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="EnvironmentStatus" Text="数据保存在此设备" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,13,0" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                <Button Content="回到今天" Style="{DynamicResource Pill}" Click="Today_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="─" Style="{DynamicResource IconPill}" Margin="15,0,5,0" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="□" Style="{DynamicResource IconPill}" Margin="0,0,5,0" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="×" Style="{DynamicResource IconPill}" Foreground="{DynamicResource DangerInk}" FontSize="21" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" MaxWidth="1800" HorizontalAlignment="Stretch" Margin="0,0,16,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="148" x:Name="NavigationColumn"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PaperSurface}" CornerRadius="0" Padding="10,18" BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True"><RadioButton x:Name="SettingsTab" GroupName="Pages" Style="{StaticResource RailTab}" ToolTip="设置" Click="SettingsTab_Click" Margin="0,0,0,4" Content="设置" DockPanel.Dock="Bottom">
                        </RadioButton>
                <StackPanel>
                    <RadioButton x:Name="HomeTab" GroupName="Pages" IsChecked="True" Style="{StaticResource RailTab}" ToolTip="每日待办" Click="HomeTab_Click" Margin="0,0,0,4" Content="今天">
                        </RadioButton>
                    <RadioButton x:Name="CalendarTab" GroupName="Pages" Style="{StaticResource RailTab}" ToolTip="月历" Click="CalendarTab_Click" Margin="0,0,0,4" Content="月历">
                        </RadioButton>
                    <RadioButton x:Name="FocusTab" GroupName="Pages" Style="{StaticResource RailTab}" ToolTip="专注" Click="FocusTab_Click" Margin="0,0,0,4" Content="专注"/>
                    <RadioButton x:Name="SearchTab" GroupName="Pages" Style="{StaticResource RailTab}" ToolTip="搜索任务和笔记" Click="SearchTab_Click" Content="搜索" Margin="0,0,0,4">
                        </RadioButton>
                    <RadioButton x:Name="CompletedTab" GroupName="Pages" Style="{StaticResource RailTab}" ToolTip="已完成" Click="CompletedTab_Click" Margin="0,0,0,4" Content="已完成">
                        </RadioButton>
                    <RadioButton x:Name="ScreenshotTab" GroupName="Pages" Style="{StaticResource RailTab}" ToolTip="截图箱" Click="ScreenshotTab_Click" Margin="0,0,0,4" Content="截图箱">
                        </RadioButton>
                    </StackPanel>
            </DockPanel></Border>
            <Grid x:Name="HomePage" Grid.Column="2" SizeChanged="HomePage_SizeChanged" PreviewKeyDown="HomePage_KeyDown">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="DateColumn" Width="0"/><ColumnDefinition x:Name="DateGap" Width="0"/><ColumnDefinition x:Name="TaskColumn" Width="1.2*"/><ColumnDefinition x:Name="NoteGap" Width="12"/><ColumnDefinition x:Name="NoteColumn" Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="DateToolbar" Grid.ColumnSpan="5" Background="Transparent" CornerRadius="6" Padding="0,8,0,12" Margin="0,0,0,16" BorderBrush="{DynamicResource Outline}" BorderThickness="0,0,0,1">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="‹" Style="{DynamicResource IconPill}" Click="PreviousDay_Click" ToolTip="前一天"/>
                        <TextBlock Text="{Binding SelectedDateLabel}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                        <Button Content="›" Style="{DynamicResource IconPill}" Click="NextDay_Click" ToolTip="后一天"/>
                        <Button Content="月历" Style="{DynamicResource Pill}" Padding="12,6" Margin="8,0,0,0" Click="CalendarTab_Click" ToolTip="选择其他日期"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="弹出当日待办" Style="{DynamicResource Pill}" Padding="12,6" FontSize="12" Click="OpenDay_Click"/>
                <ListBox Grid.Row="1" Grid.ColumnSpan="3" Foreground="{DynamicResource TextInk}" ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay, Mode=TwoWay}" SelectionChanged="Days_SelectionChanged" Background="Transparent" BorderThickness="0" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
 <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="7"/></ItemsPanelTemplate></ListBox.ItemsPanel>
 <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource WorkspaceFocus}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Day" Background="Transparent" CornerRadius="6" Padding="2,4" Margin="3,0"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Day" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
 <ListBox.ItemTemplate><DataTemplate><StackPanel HorizontalAlignment="Center"><TextBlock Text="{Binding Weekday}" FontSize="11" HorizontalAlignment="Center"/><TextBlock Text="{Binding DayNumber}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
 </ListBox></Grid>
            </Border>
            <Border x:Name="DateRail" Grid.Row="1" Grid.Column="0" Visibility="Collapsed" Background="#E6F2ED" CornerRadius="6" Padding="17,20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="日历" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="选择一天，记录生活" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    <Grid Grid.Row="1" Margin="0,18,0,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                        <Button Content="‹" Style="{DynamicResource IconPill}" Width="26" Height="29" Click="PreviousWeek_Click"/>
                        <TextBlock Grid.Column="1" Text="{Binding MonthLabel}" FontWeight="Bold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="›" Style="{DynamicResource IconPill}" Width="26" Height="29" Click="NextWeek_Click"/>
                    </Grid>
                    <ListBox Grid.Row="2" Foreground="{DynamicResource TextInk}" ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay, Mode=TwoWay}" SelectionChanged="Days_SelectionChanged" ItemContainerStyle="{StaticResource DayRow}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate><DataTemplate><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DayNumber}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Weekday}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel>
                        </Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3" Content="✦ 弹出当日待办" Style="{DynamicResource Pill}" FontSize="11" Padding="8,8" Click="OpenDay_Click"/>
                </Grid>
            </Border>
            <Grid x:Name="TaskContent" Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition x:Name="MemoRow" Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="TasksCard" Background="Transparent" CornerRadius="0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock x:Name="TaskDateSubtitle" Text="{Binding SelectedDateLabel}" Foreground="{DynamicResource Muted}" FontSize="11" Visibility="Collapsed"/>
                                <TextBlock Text="{Binding TaskHeader}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,3,0,0"/></StackPanel>
                            <Border Grid.Column="1" Background="#E6F2ED" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProgressLabel}" Foreground="#217D6F" FontWeight="Bold" FontSize="11"/></Border>
                        </Grid>
                        <Border x:Name="TaskDivider" Grid.Row="1" Height="1" Background="#D7E2DC" Margin="0,15,0,15" Visibility="Collapsed"/>
                        <Border x:Name="OverdueSection" Grid.Row="3" Visibility="Collapsed" Background="Transparent" CornerRadius="6" Padding="0,6" Margin="0">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OverdueCountLabel}" Foreground="#A26443" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Button x:Name="OverdueToggle" Grid.Column="1" Content="收起" Style="{DynamicResource Pill}" FontSize="10" Padding="8,4" Click="OverdueToggle_Click"/>
                                </Grid>
                                <ListBox x:Name="OverdueList" ItemsSource="{Binding OverdueTasks}" Margin="0,7,0,0" MaxHeight="90" ItemContainerStyle="{StaticResource OverdueRow}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate><DataTemplate><Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" Style="{StaticResource IslandCheck}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat={}{0:M月d日}}" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Style="{StaticResource OverdueLink}" Click="OpenOverdue_Click" ToolTip="打开原日期的任务">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                    </Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="2">
                        <ListBox x:Name="TaskList" ItemsSource="{Binding ActiveTasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}" PreviewMouseLeftButtonUp="TaskList_MouseLeftButtonUp" PreviewKeyDown="TaskList_KeyDown" ItemContainerStyle="{StaticResource TaskRow}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0">
                            <ListBox.ItemTemplate><DataTemplate><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" Click="TaskCheck_Click" Style="{StaticResource IslandCheck}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,8,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                    <TextBlock Text="{Binding PlanLabel}" FontSize="10" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerInk}"/></DataTrigger><DataTrigger Binding="{Binding PlanLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ReminderLabel}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                                    <Button Content="⋯" Style="{DynamicResource Pill}" Padding="6,1" Margin="5,0,0,0" ToolTip="日期与推进、今天先到这里" Click="TaskPlanning_Click"/>
                                </StackPanel>
                            </Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyTaskMessage}" Foreground="{DynamicResource Muted}" FontSize="12" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding HasActiveTasks}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        </Grid>
                        <Expander Grid.Row="4" Header="{Binding ShelvedLabel}" FontSize="11" Margin="0,7,0,0">
                            <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasShelvedTasks}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                            <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ShelvedTasks}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="4,5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="继续处理" Style="{DynamicResource Pill}" FontSize="10" Padding="8,3" Click="ContinueTask_Click"/>
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        </Expander>
                        <Grid Grid.Row="1" Margin="0,12,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTaskBox" Style="{DynamicResource PaperInput}" KeyDown="NewTaskBox_KeyDown" ToolTip="输入任务名称，按回车添加"/>
                            <Button Grid.Column="2" Content="＋ 添加" Style="{DynamicResource PrimaryPill}" Click="AddTask_Click"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="MemoCard" Grid.Row="2" Background="Transparent" CornerRadius="0" Padding="0,4">
                    <Expander x:Name="MemoExpander" Header="随手记" IsExpanded="True" FontSize="12"><Grid><TextBox x:Name="DayMemoBox" Grid.Row="0" Text="{Binding DayMemo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextInk}" Padding="0,7,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="60" MaxHeight="100"/>
                    </Grid>
                </Expander></Border>
            </Grid>
            <Border x:Name="TaskNotePanel" Grid.Row="1" Grid.Column="4" Background="Transparent" CornerRadius="0" Padding="20,0,0,0" BorderBrush="{DynamicResource Outline}" BorderThickness="1,0,0,0" MaxWidth="720">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="BackToTasksButton" Content="‹ 待办" Visibility="Collapsed" Style="{DynamicResource Pill}" Padding="10,6" Margin="0,0,12,0" Click="BackToTasks_Click" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="任务笔记" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock x:Name="NoteSubtitle" Text="只读预览 · 在便签中编辑" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                        <Button Grid.Column="2" Content="在便签中编辑" Style="{DynamicResource Pill}" FontSize="11" Padding="9,5" VerticalAlignment="Center" IsEnabled="{Binding HasSelectedTask}" Click="OpenNote_Click"/>
                    </Grid>
                    <Border x:Name="NoteDivider" Grid.Row="1" Height="1" Background="#D7E2DC" Margin="0,10"/>
                    <TextBox Grid.Row="2" Text="{Binding SelectedTask.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource PaperInput}" FontWeight="SemiBold" IsEnabled="{Binding HasSelectedTask}" Margin="0,0,0,11" ToolTip="编辑任务名称"/>
                    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><local:FocusBar x:Name="TaskFocus" Background="{DynamicResource SelectedSurface}" CornerRadius="6"/><local:MarkdownNoteView x:Name="TaskNoteEditor" Grid.Row="1" DisplayOnly="True" Task="{Binding SelectedTask}" IsEnabled="{Binding HasSelectedTask}"/></Grid>
                    <Expander Header="任务安排与更多操作" Grid.Row="4" FontSize="12" Margin="0,12,0,0"><StackPanel Margin="0,8,0,0">
                        <DockPanel Margin="0,0,0,7">
                            <Button DockPanel.Dock="Right" Content="日期与推进" Style="{DynamicResource Pill}" FontSize="11" Padding="10,5" IsEnabled="{Binding HasSelectedTask}" Click="PlanTask_Click"/>
                            <TextBlock Text="{Binding SelectedTask.PlanLabel}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedTask.CompletionLabel}" FontSize="11" Foreground="#397457" TextWrapping="Wrap"/>
                        <TextBlock Text="提醒时间 · 24 小时制，留空则不提醒" Foreground="{DynamicResource Muted}" FontSize="11"/>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ReminderBox" Style="{DynamicResource PaperInput}" IsEnabled="{Binding HasSelectedTask}" ToolTip="例如 14:30"/>
                            <Button Grid.Column="2" Content="设置" Style="{DynamicResource Pill}" IsEnabled="{Binding HasSelectedTask}" Click="SetReminder_Click"/>
                        </Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Content="{Binding RepeatButtonLabel}" Style="{DynamicResource Pill}" HorizontalAlignment="Left" FontSize="11" Padding="11,7" IsEnabled="{Binding HasSelectedTask}" Click="RepeatRule_Click"/>
                            <Button Grid.Column="1" Content="删除此任务" Style="{DynamicResource DangerPill}" HorizontalAlignment="Right" FontSize="11" Padding="11,7" IsEnabled="{Binding HasSelectedTask}" Click="DeleteTask_Click"/>
                        </Grid>
                    </StackPanel>
                </Expander></Grid>
            </Border>
            </Grid>
            <Border x:Name="CalendarPage" Grid.Column="2" Visibility="Collapsed" PreviewKeyDown="CalendarPage_KeyDown" Background="{DynamicResource Card}" CornerRadius="0" Padding="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="4,0,4,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="月历" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock Text="记录安排、实际投入和完成的每一天" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CalendarPreviousButton" Content="‹" Style="{DynamicResource IconPill}" Width="30" Height="31" Click="CalendarPrevious_Click" ToolTip="上个月"/>
                            <TextBlock Text="{Binding CalendarMonthLabel}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Ink}" Width="130" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button x:Name="CalendarNextButton" Content="›" Style="{DynamicResource IconPill}" Width="30" Height="31" Click="CalendarNext_Click" ToolTip="下个月"/>
                            <Button x:Name="CalendarTodayButton" Content="今天" Style="{DynamicResource Pill}" Padding="12,6" Margin="13,0,0,0" Click="CalendarToday_Click"/>
                            <Button x:Name="CalendarAddButton" Content="＋ 添加" Style="{DynamicResource PrimaryPill}" Padding="13,6" Margin="8,0,0,0" Click="CalendarAdd_Click" ToolTip="在选中的日期添加待办"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Grid.Row="1" Margin="4,0,4,5">
                        <RadioButton x:Name="CalendarAllFilter" GroupName="CalendarFilters" Content="全部" IsChecked="True" Style="{StaticResource CompletedFilter}" Click="CalendarFilter_Click"/>
                        <RadioButton x:Name="CalendarPendingFilter" GroupName="CalendarFilters" Content="未完成" Style="{StaticResource CompletedFilter}" Click="CalendarFilter_Click" Margin="7,0,0,0"/>
                        <RadioButton x:Name="CalendarDoneFilter" GroupName="CalendarFilters" Content="已完成" Style="{StaticResource CompletedFilter}" Click="CalendarFilter_Click" Margin="7,0,0,0"/>
                        <TextBlock Text="✓ 完成  ◷ 推进  ! 逾期  ○ 安排  ↻ 重复" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="14,5,0,5"/>
                    </WrapPanel>
                    <UniformGrid Grid.Row="2" Columns="7" Margin="2,0,2,2">
                        <TextBlock Text="周日"/><TextBlock Text="周一"/><TextBlock Text="周二"/><TextBlock Text="周三"/>
                        <TextBlock Text="周四"/><TextBlock Text="周五"/><TextBlock Text="周六"/>
                        <UniformGrid.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
                        </Style></UniformGrid.Resources>
                    </UniformGrid>
                    <Border Grid.Row="3" Background="#D7E2DC" CornerRadius="6" Padding="2">
                        <ScrollViewer x:Name="CalendarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CalendarGrid" ItemsSource="{Binding CalendarDays}" SizeChanged="CalendarGrid_SizeChanged" Height="{Binding ActualHeight, ElementName=CalendarScroll, Converter={StaticResource CalendarGridHeight}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Margin="0" Padding="7,5" CornerRadius="0" Cursor="Hand" MouseLeftButtonUp="CalendarDay_Click">
                                    <Border.Style><Style TargetType="Border">
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Background" Value="#EDF2EF"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#E6F2ED"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style></Border.Style>
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Summary}" ToolTip="{Binding SummaryHint}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource Muted}"/>
                                        <Border Width="26" Height="25" HorizontalAlignment="Left" CornerRadius="9">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers>
                                            </Style></Border.Style>
                                            <TextBlock Text="{Binding DayNumber}" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                            <ItemsControl ItemsSource="{Binding VisibleEntries}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Button Style="{StaticResource CalendarTaskChip}" Click="CalendarTask_Click" ToolTip="{Binding Hint}">
                                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    </Button>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="{Binding OverflowLabel}" FontSize="10" Click="CalendarMore_Click" Padding="3,2" HorizontalAlignment="Stretch">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CalendarTaskChip}"><Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasOverflow}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style></Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Border x:Name="CalendarDayOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="{DynamicResource PaperSurface}" BorderBrush="#D7E2DC" BorderThickness="1" CornerRadius="6" Padding="18" Margin="10" MaxWidth="650">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Content="返回月历" Style="{DynamicResource Pill}" Click="CalendarCloseDay_Click"/>
                                <TextBlock x:Name="CalendarDayHeading" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="CalendarDayEntries"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Style="{StaticResource CalendarTaskChip}" Padding="12,10" Click="CalendarTask_Click" ToolTip="{Binding Hint}">
                                        <StackPanel><TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="SearchPage" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource Card}" CornerRadius="0" Padding="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="找一找  ✿" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="任务名称、任务笔记和每日备忘，都能在这里找到" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,19,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{DynamicResource PaperInput}" KeyDown="SearchBox_KeyDown" ToolTip="输入关键词，按回车搜索"/>
                        <Button Grid.Column="2" Content="搜索" Style="{DynamicResource PrimaryPill}" Click="Search_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding SearchStatus}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,14,0,12"/>
                    <Grid Grid.Row="3">
                    <ListBox x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}" SelectionChanged="SearchResults_SelectionChanged" ItemContainerStyle="{StaticResource TaskRow}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis" MaxWidth="550"/>
                                    <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource AccentOutline}" FontSize="10" Margin="10,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DateLabel}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Snippet}" Foreground="#8E7E67" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style><Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasSearchResults}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <Border Width="74" Height="74" CornerRadius="6" Background="#E3F8F3" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Grid Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="21" Height="21" Margin="1,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="{DynamicResource Accent}" StrokeThickness="2.5"/>
                                <Path Data="M 22,22 L 30,30" Stroke="{DynamicResource Accent}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="想找哪件事？" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center"/>
                        <TextBlock Text="输入关键词，按回车试试看" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="CompletedPage" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource Card}" CornerRadius="0" Padding="0,16,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="已完成" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="{Binding CompletedCountLabel}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,14">
                        <RadioButton x:Name="AllCompletedFilter" Content="全部日期" GroupName="CompletedDates" IsChecked="True" Style="{StaticResource CompletedFilter}" Click="CompletedFilter_Click"/>
                        <RadioButton x:Name="TodayCompletedFilter" Content="今天" GroupName="CompletedDates" Style="{StaticResource CompletedFilter}" Click="CompletedFilter_Click"/>
                        <RadioButton x:Name="WeekCompletedFilter" Content="近 7 天" GroupName="CompletedDates" Style="{StaticResource CompletedFilter}" Click="CompletedFilter_Click"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CompletedGroups}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="0,0,0,15">
                                        <Grid Margin="4,0,4,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DateLabel}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CountLabel}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="10,3,0,0"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Tasks}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border Background="{DynamicResource PaperSurface}" BorderBrush="#D7E2DC" BorderThickness="1" CornerRadius="6" Padding="15,12" Margin="0,0,0,8">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource AccentOutline}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="✓" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="1,0,12,0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="原定 " FontSize="10" Foreground="{DynamicResource Muted}"/>
                                                                <TextBlock Text="{Binding Date, StringFormat={}{0:M月d日}}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                                                                <TextBlock Text="{Binding Note}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="310"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="恢复待办" Style="{DynamicResource Pill}" FontSize="11" Padding="10,6" VerticalAlignment="Center" Tag="{Binding}" Click="RestoreCompleted_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding HasCompletedTasks}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></StackPanel.Style>
                            <Border Width="68" Height="68" Background="#E6F2ED" CornerRadius="6" HorizontalAlignment="Center" Margin="0,0,0,13">
                                <TextBlock Text="✓" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="这里还没有完成的任务" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center"/>
                            <TextBlock Text="勾选待办后，就会收在这里" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="SettingsPage" Grid.Column="2" Visibility="Collapsed" Background="{DynamicResource Card}" CornerRadius="0" Padding="0,16,0,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel x:Name="SettingsNavigation" Width="130" Margin="0,16,18,0"><TextBlock Text="设置分组" Foreground="{DynamicResource Muted}" Margin="12,0,0,16" FontSize="12"/><Button Content="启动与常驻" Tag="startup" Click="SettingsSection_Click" Style="{DynamicResource Pill}" Margin="0,0,0,8"/><Button Content="截图与暂存" Tag="capture" Click="SettingsSection_Click" Style="{DynamicResource Pill}" Margin="0,0,0,8"/><Button Content="笔记图片" Tag="images" Click="SettingsSection_Click" Style="{DynamicResource Pill}"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Column="1">
                <StackPanel MaxWidth="740" HorizontalAlignment="Stretch">
                    <TextBlock Text="设置" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    <TextBlock Text="让小岛按你的习惯运行" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,22"/>
                    <Border Background="Transparent" BorderBrush="#D7E2DC" BorderThickness="0,0,0,1" CornerRadius="0" Padding="0,12,0,18" x:Name="StartupSection">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="开机后在后台提醒我" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                <TextBlock Text="登录 Windows 后驻留托盘，不自动打开主窗口；随时可从托盘打开。" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                            <CheckBox x:Name="AutostartCheck" Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0" Style="{StaticResource IslandCheck}" Click="AutostartCheck_Click" ToolTip="开机自启"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SettingsStatus" FontSize="11" Foreground="{DynamicResource Muted}" Margin="3,13,0,0"/>
                    <local:ScreenshotSettingsView x:Name="ScreenshotSettings" Margin="0,12,0,0"/>
                    <Button Content="专注时长与提醒设置" Click="FocusTab_Click" Style="{DynamicResource Pill}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    <Border Background="Transparent" BorderBrush="#D7E2DC" BorderThickness="0,0,0,1" CornerRadius="0" Padding="0,12,0,18" Margin="0,12,0,0" x:Name="AttachmentSection">
                        <StackPanel>
                            <TextBlock Text="笔记图片" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock x:Name="AttachmentUsageText" Text="按需保存，独立于截图箱" FontSize="12" Foreground="{DynamicResource TextInk}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="正文、备份和找回副本引用的图片会保留。本次运行中用过的图片也会保留，方便撤销；重启后可再次检查。" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button Content="刷新占用" Style="{DynamicResource Pill}" Click="RefreshAttachments_Click" Margin="0,0,8,0"/>
                                <Button x:Name="CleanAttachmentsButton" Content="清理未使用图片" Style="{DynamicResource Pill}" Click="CleanAttachments_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Grid></Border>
            <local:FocusPage x:Name="FocusView" Grid.Column="2" Visibility="Collapsed"/>
            <local:ScreenshotPage x:Name="ScreenshotGallery" Grid.Column="2" Visibility="Collapsed"/>
        </Grid>
    <Border x:Name="CompletionNotice" Grid.Row="1" Panel.ZIndex="10" Visibility="Collapsed" Background="#263D38" CornerRadius="6" Padding="14,9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16" MaxWidth="620"><DockPanel><Button x:Name="RestoreNoticeButton" DockPanel.Dock="Right" Content="恢复待办" Click="RestoreNotice_Click" Style="{DynamicResource Pill}" Margin="12,0,0,0"/><TextBlock x:Name="CompletionNoticeText" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border></Grid>
</Window>
