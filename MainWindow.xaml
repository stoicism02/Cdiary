<Window x:Class="Cdiary.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Cdiary"
        Title="小岛日记" Icon="/Cdiary;component/Assets/Cdiary.ico" Width="1100" Height="720" MinWidth="760" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowSurface}" FontFamily="Microsoft YaHei UI"
        FontSize="14" Foreground="{DynamicResource TextInk}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="82" ResizeBorderThickness="6" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><local:LiveStyleDictionary/></ResourceDictionary.MergedDictionaries>
        <local:CalendarGridHeightConverter x:Key="CalendarGridHeight"/>

        <Style x:Key="RailTab" TargetType="RadioButton">
            <Setter Property="Width" Value="48"/><Setter Property="Height" Value="55"/>
            <Setter Property="Foreground" Value="#8D806A"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Tile" Background="Transparent" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource PaperSurface}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Tile" Property="Background" Value="#DDF7F1"/>
                        <Setter Property="Foreground" Value="{DynamicResource AccentOutline}"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.08"/>
                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.08"/>
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CompletedFilter" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#8D806A"/>
            <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Chip" Background="{DynamicResource PaperSurface}" BorderBrush="#D8CBB3" BorderThickness="1.5"
                        CornerRadius="15" Padding="14,8">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#DDF7F1"/>
                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentOutline}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CalendarTaskChip" TargetType="Button">
            <Setter Property="Background" Value="#E7F0F2"/><Setter Property="Foreground" Value="#526F7A"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,0,3"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chip" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Done"><Setter Property="Background" Value="#DDF7E9"/><Setter Property="Foreground" Value="#397457"/></DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Today"><Setter Property="Background" Value="#FFF0D3"/><Setter Property="Foreground" Value="#946421"/></DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Overdue"><Setter Property="Background" Value="#FBE2DD"/><Setter Property="Foreground" Value="#A34F45"/></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Opacity" Value="0.75"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="DayRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Background="Transparent" CornerRadius="16" Padding="11,8"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E6F9F6"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TaskRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Background="{DynamicResource PaperSurface}" BorderBrush="#E5DCC7" BorderThickness="1.5"
                        CornerRadius="17" Padding="14,12"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E6F9F6"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OverdueRow" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border Background="{DynamicResource PaperSurface}" BorderBrush="#E5DCC7" BorderThickness="1.5"
                        CornerRadius="13" Padding="9,7"><ContentPresenter/></Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="OverdueLink" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextInk}"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentOutline}"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="IslandCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Width="25" Height="25" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform><ScaleTransform x:Name="CheckScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                    <Border x:Name="Box" Background="{DynamicResource PaperSurface}" BorderBrush="{DynamicResource Muted}" BorderThickness="2" CornerRadius="8"/>
                    <Path x:Name="Tick" Data="M 5 12 L 10 17 L 20 7" Stroke="White" StrokeThickness="2.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                        <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentOutline}"/>
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To="0.8" Duration="0:0:0.08"/>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To="0.8" Duration="0:0:0.08"/>
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CheckScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.26">
                                <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Background" Value="#F0E8D8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,0">
                    <Track x:Name="PART_Track" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"
                           IsDirectionReversed="True" Margin="1">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb>
                            <Thumb.Template><ControlTemplate TargetType="Thumb">
                                <Border Background="{DynamicResource Accent}" BorderBrush="#11A89B" BorderThickness="0,0,2,0" CornerRadius="7">
                                    <Border Width="3" Margin="3,5,0,5" Background="#7EE4DB" CornerRadius="2" HorizontalAlignment="Left"/>
                                </Border>
                            </ControlTemplate></Thumb.Template>
                        </Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                        </Track.IncreaseRepeatButton>
                    </Track>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </ResourceDictionary></Window.Resources>
    <Grid x:Name="LayoutRoot" Margin="25,8,25,23" SizeChanged="LayoutRoot_SizeChanged">
        <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="50" Height="50" Background="{DynamicResource Accent}" CornerRadius="18" Margin="0,0,13,0">
                    <TextBlock Text="✿" Foreground="White" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="AppHeading" Text="小岛日记" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    <TextBlock x:Name="BrandSubtitle" Text="把今天过好，一件一件来。" Foreground="{DynamicResource Muted}" FontSize="11"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="EnvironmentStatus" Text="数据保存在此设备" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,13,0" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                <Button Content="回到今天" Style="{DynamicResource Pill}" Click="Today_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="─" Style="{DynamicResource IconPill}" Margin="15,0,5,0" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="□" Style="{DynamicResource IconPill}" Margin="0,0,5,0" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button Content="×" Style="{DynamicResource IconPill}" Foreground="{DynamicResource DangerInk}" FontSize="21" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" MaxWidth="1680">
            <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F0E8D8" CornerRadius="23" Padding="6,12">
                <StackPanel>
                    <RadioButton x:Name="HomeTab" GroupName="Pages" IsChecked="True" Style="{StaticResource RailTab}"
                                 ToolTip="每日待办" Click="HomeTab_Click" Margin="0,0,0,9">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M 3,11 L 12,4 L 21,11 M 6,10 L 6,20 L 18,20 L 18,10 M 10,20 L 10,14 L 14,14 L 14,20"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="24" Height="24" Stretch="None" HorizontalAlignment="Center"/>
                            <TextBlock Text="待办" FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CalendarTab" GroupName="Pages" Style="{StaticResource RailTab}"
                                 ToolTip="月历" Click="CalendarTab_Click" Margin="0,0,0,9">
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="23" Height="23" HorizontalAlignment="Center">
                                <Border BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                        BorderThickness="1.8" CornerRadius="4" Margin="1,3,1,1"/>
                                <Path Data="M 2,9 L 21,9 M 7,1 L 7,6 M 16,1 L 16,6"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"/>
                                <Ellipse Width="2.7" Height="2.7" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,12,0,0"/>
                                <Ellipse Width="2.7" Height="2.7" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="13,12,0,0"/>
                            </Grid>
                            <TextBlock Text="日历" FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FocusTab" GroupName="Pages" Style="{StaticResource RailTab}" ToolTip="专注" Click="FocusTab_Click" Margin="0,9,0,0" Content="◷"/>
                    <RadioButton x:Name="SearchTab" GroupName="Pages" Style="{StaticResource RailTab}"
                                 ToolTip="搜索任务和笔记" Click="SearchTab_Click">
                        <StackPanel HorizontalAlignment="Center">
                            <Grid Width="24" Height="24" HorizontalAlignment="Center">
                                <Ellipse Width="14" Height="14" Margin="2,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8"/>
                                <Path Data="M 16,16 L 22,22" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </Grid>
                            <TextBlock Text="搜索" FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="CompletedTab" GroupName="Pages" Style="{StaticResource RailTab}"
                                 ToolTip="已完成" Click="CompletedTab_Click" Margin="0,9,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="✓" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="完成" FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ScreenshotTab" GroupName="Pages" Style="{StaticResource RailTab}"
                                 ToolTip="截图箱" Click="ScreenshotTab_Click" Margin="0,9,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="M 2,7 L 7,7 L 9,3 L 16,3 L 18,7 L 22,7 L 22,21 L 2,21 Z M 17,14 A 5,5 0 1 1 7,14 A 5,5 0 1 1 17,14"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.8" StrokeLineJoin="Round" Width="24" Height="24" HorizontalAlignment="Center"/>
                            <TextBlock Text="截图" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsTab" GroupName="Pages" Style="{StaticResource RailTab}"
                                 ToolTip="设置" Click="SettingsTab_Click" Margin="0,9,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="23" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="设置" FontSize="10" HorizontalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
            <Grid x:Name="HomePage" Grid.Column="2" SizeChanged="HomePage_SizeChanged" PreviewKeyDown="HomePage_KeyDown">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="DateColumn" Width="0"/><ColumnDefinition x:Name="DateGap" Width="0"/><ColumnDefinition x:Name="TaskColumn" Width="1.2*"/><ColumnDefinition x:Name="NoteGap" Width="12"/><ColumnDefinition x:Name="NoteColumn" Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="DateToolbar" Grid.ColumnSpan="5" Background="#F0E8D8" CornerRadius="17" Padding="10,7" Margin="0,0,0,12">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="‹" Style="{DynamicResource IconPill}" Click="PreviousDay_Click" ToolTip="前一天"/>
                        <TextBlock Text="{Binding SelectedDateLabel}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
                        <Button Content="›" Style="{DynamicResource IconPill}" Click="NextDay_Click" ToolTip="后一天"/>
                        <Button Content="月历" Style="{DynamicResource Pill}" Padding="12,6" Margin="8,0,0,0" Click="CalendarTab_Click" ToolTip="选择其他日期"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="弹出当日待办" Style="{DynamicResource Pill}" Padding="12,6" FontSize="12" Click="OpenDay_Click"/>
                </Grid>
            </Border>
            <Border x:Name="DateRail" Grid.Row="1" Grid.Column="0" Visibility="Collapsed" Background="#F0E8D8" CornerRadius="24" Padding="17,20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="日历" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="选择一天，记录生活" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                    <Grid Grid.Row="1" Margin="0,18,0,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                        <Button Content="‹" Style="{DynamicResource IconPill}" Width="26" Height="29" Click="PreviousWeek_Click"/>
                        <TextBlock Grid.Column="1" Text="{Binding MonthLabel}" FontWeight="Bold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="›" Style="{DynamicResource IconPill}" Width="26" Height="29" Click="NextWeek_Click"/>
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                             SelectionChanged="Days_SelectionChanged" ItemContainerStyle="{StaticResource DayRow}" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate><DataTemplate><Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DayNumber}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Weekday}" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="{Binding Hint}" FontSize="10" Foreground="{DynamicResource Muted}"/></StackPanel>
                        </Grid></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="3" Content="✦ 弹出当日待办" Style="{DynamicResource Pill}"
                            FontSize="11" Padding="8,8" Click="OpenDay_Click"/>
                </Grid>
            </Border>
            <Grid x:Name="TaskContent" Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition x:Name="MemoRow" Height="155"/></Grid.RowDefinitions>
                <Border x:Name="TasksCard" Background="{DynamicResource Card}" CornerRadius="24" Padding="20,19">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock x:Name="TaskDateSubtitle" Text="{Binding SelectedDateLabel}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                <TextBlock Text="{Binding TaskHeader}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Ink}" Margin="0,3,0,0"/></StackPanel>
                            <Border Grid.Column="1" Background="#E6F9F6" CornerRadius="15" Padding="10,5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ProgressLabel}" Foreground="#11A89B" FontWeight="Bold" FontSize="11"/></Border>
                        </Grid>
                        <Border x:Name="TaskDivider" Grid.Row="1" Height="1" Background="#D8CCB6" Margin="0,15,0,15"/>
                        <Border x:Name="OverdueSection" Grid.Row="2" Visibility="Collapsed" Background="#FFF0DF"
                                CornerRadius="16" Padding="10,9" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding OverdueCountLabel}" Foreground="#A26443" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    <Button x:Name="OverdueToggle" Grid.Column="1" Content="收起" Style="{DynamicResource Pill}"
                                            FontSize="10" Padding="8,4" Click="OverdueToggle_Click"/>
                                </Grid>
                                <ListBox x:Name="OverdueList" ItemsSource="{Binding OverdueTasks}" Margin="0,7,0,0"
                                         MaxHeight="112" ItemContainerStyle="{StaticResource OverdueRow}"
                                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate><DataTemplate><Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="29"/><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" Style="{StaticResource IslandCheck}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Date, StringFormat={}{0:M月d日}}" FontSize="10"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Style="{StaticResource OverdueLink}" Click="OpenOverdue_Click" ToolTip="打开原日期的任务">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        </Button>
                                    </Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="3">
                        <ListBox x:Name="TaskList" ItemsSource="{Binding ActiveTasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                 PreviewMouseLeftButtonUp="TaskList_MouseLeftButtonUp" PreviewKeyDown="TaskList_KeyDown"
                                 ItemContainerStyle="{StaticResource TaskRow}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate><DataTemplate><Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" Click="TaskCheck_Click" Style="{StaticResource IslandCheck}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,8,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding ReminderLabel}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                            </Grid></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyTaskMessage}" Foreground="{DynamicResource Muted}" FontSize="12"
                                   TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding HasActiveTasks}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        </Grid>
                        <Grid Grid.Row="4" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="NewTaskBox" Style="{DynamicResource PaperInput}" KeyDown="NewTaskBox_KeyDown" ToolTip="输入任务名称，按回车添加"/>
                            <Button Grid.Column="2" Content="＋ 添加" Style="{DynamicResource PrimaryPill}" Click="AddTask_Click"/>
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="MemoCard" Grid.Row="2" Background="#F7CD67" CornerRadius="24" Padding="20,15">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="今日备忘" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                        <TextBox x:Name="DayMemoBox" Grid.Row="1" Text="{Binding DayMemo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextInk}" Padding="0,7,0,0"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Border>
            </Grid>
            <Border x:Name="TaskNotePanel" Grid.Row="1" Grid.Column="4" Background="{DynamicResource Card}" CornerRadius="24" Padding="20,19">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="BackToTasksButton" Content="‹ 待办" Visibility="Collapsed" Style="{DynamicResource Pill}" Padding="10,6" Margin="0,0,12,0" Click="BackToTasks_Click" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1"><TextBlock Text="任务笔记  ✿" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock x:Name="NoteSubtitle" Text="把常用信息留在任务旁边" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                        <Button Grid.Column="2" Content="打开便签" Style="{DynamicResource Pill}" FontSize="11" Padding="9,5"
                                VerticalAlignment="Center" IsEnabled="{Binding HasSelectedTask}" Click="OpenNote_Click"/>
                    </Grid>
                    <Border x:Name="NoteDivider" Grid.Row="1" Height="1" Background="#D8CCB6" Margin="0,15,0,15"/>
                    <TextBox Grid.Row="2" Text="{Binding SelectedTask.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource PaperInput}" FontWeight="SemiBold" IsEnabled="{Binding HasSelectedTask}" Margin="0,0,0,11" ToolTip="编辑任务名称"/>
                    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><local:FocusBar x:Name="TaskFocus"/><local:MarkdownNoteView x:Name="TaskNoteEditor" Grid.Row="1" DisplayOnly="True" Task="{Binding SelectedTask}" IsEnabled="{Binding HasSelectedTask}"/></Grid>
                    <StackPanel Grid.Row="4" Margin="0,13,0,0">
                        <TextBlock Text="{Binding SelectedTask.CompletionLabel}" FontSize="11" Foreground="#397457" TextWrapping="Wrap"/>
                        <TextBlock Text="提醒时间 · 24 小时制，留空则不提醒" Foreground="{DynamicResource Muted}" FontSize="11"/>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ReminderBox" Style="{DynamicResource PaperInput}" IsEnabled="{Binding HasSelectedTask}" ToolTip="例如 14:30"/>
                            <Button Grid.Column="2" Content="设置" Style="{DynamicResource Pill}" IsEnabled="{Binding HasSelectedTask}" Click="SetReminder_Click"/>
                        </Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Button Content="{Binding RepeatButtonLabel}" Style="{DynamicResource Pill}" HorizontalAlignment="Left" FontSize="11" Padding="11,7"
                                    IsEnabled="{Binding HasSelectedTask}" Click="RepeatRule_Click"/>
                            <Button Grid.Column="1" Content="删除此任务" Style="{DynamicResource DangerPill}" HorizontalAlignment="Right" FontSize="11" Padding="11,7"
                                    IsEnabled="{Binding HasSelectedTask}" Click="DeleteTask_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
            <Border x:Name="CalendarPage" Grid.Column="2" Visibility="Collapsed" PreviewKeyDown="CalendarPage_KeyDown"
                    Background="{DynamicResource Card}" CornerRadius="24" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="4,0,4,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="月历  ✿" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock Text="安排与完成，都留在这一天" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CalendarPreviousButton" Content="‹" Style="{DynamicResource IconPill}" Width="30" Height="31" Click="CalendarPrevious_Click" ToolTip="上个月"/>
                            <TextBlock Text="{Binding CalendarMonthLabel}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                                       Width="130" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button x:Name="CalendarNextButton" Content="›" Style="{DynamicResource IconPill}" Width="30" Height="31" Click="CalendarNext_Click" ToolTip="下个月"/>
                            <Button x:Name="CalendarTodayButton" Content="今天" Style="{DynamicResource Pill}" Padding="12,6" Margin="13,0,0,0" Click="CalendarToday_Click"/>
                            <Button x:Name="CalendarAddButton" Content="＋ 添加" Style="{DynamicResource PrimaryPill}" Padding="13,6" Margin="8,0,0,0"
                                    Click="CalendarAdd_Click" ToolTip="在选中的日期添加待办"/>
                        </StackPanel>
                    </Grid>
                    <WrapPanel Grid.Row="1" Margin="4,0,4,5">
                        <RadioButton x:Name="CalendarAllFilter" GroupName="CalendarFilters" Content="全部" IsChecked="True" Style="{StaticResource CompletedFilter}" Click="CalendarFilter_Click"/>
                        <RadioButton x:Name="CalendarPendingFilter" GroupName="CalendarFilters" Content="未完成" Style="{StaticResource CompletedFilter}" Click="CalendarFilter_Click" Margin="7,0,0,0"/>
                        <RadioButton x:Name="CalendarDoneFilter" GroupName="CalendarFilters" Content="已完成" Style="{StaticResource CompletedFilter}" Click="CalendarFilter_Click" Margin="7,0,0,0"/>
                        <TextBlock Text="✓ 完成  ○ 今日  ! 逾期  ↻ 重复" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="14,5,0,5"/>
                    </WrapPanel>
                    <UniformGrid Grid.Row="2" Columns="7" Margin="2,0,2,2">
                        <TextBlock Text="周日"/><TextBlock Text="周一"/><TextBlock Text="周二"/><TextBlock Text="周三"/>
                        <TextBlock Text="周四"/><TextBlock Text="周五"/><TextBlock Text="周六"/>
                        <UniformGrid.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                            <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="TextAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
                        </Style></UniformGrid.Resources>
                    </UniformGrid>
                    <Border Grid.Row="3" Background="#E8DFCA" CornerRadius="15" Padding="2">
                        <ScrollViewer x:Name="CalendarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CalendarGrid" ItemsSource="{Binding CalendarDays}" SizeChanged="CalendarGrid_SizeChanged"
                                      Height="{Binding ActualHeight, ElementName=CalendarScroll, Converter={StaticResource CalendarGridHeight}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Margin="2" Padding="7,5" CornerRadius="10" Cursor="Hand"
                                        MouseLeftButtonUp="CalendarDay_Click">
                                    <Border.Style><Style TargetType="Border">
                                        <Setter Property="Background" Value="#FFFBE9"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Background" Value="#F3EFDF"/></DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#E6F9F6"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style></Border.Style>
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Summary}" ToolTip="{Binding SummaryHint}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource Muted}"/>
                                        <Border Width="26" Height="25" HorizontalAlignment="Left" CornerRadius="9">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers>
                                            </Style></Border.Style>
                                            <TextBlock Text="{Binding DayNumber}" FontSize="12" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="Foreground" Value="White"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                            <ItemsControl ItemsSource="{Binding VisibleEntries}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Button Style="{StaticResource CalendarTaskChip}" Click="CalendarTask_Click" ToolTip="{Binding Hint}">
                                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    </Button>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="{Binding OverflowLabel}" FontSize="10" Click="CalendarMore_Click" Padding="3,2" HorizontalAlignment="Stretch">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CalendarTaskChip}"><Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasOverflow}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                </Style></Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Border x:Name="CalendarDayOverlay" Grid.RowSpan="4" Visibility="Collapsed" Background="{DynamicResource PaperSurface}" BorderBrush="#D8CCB6" BorderThickness="1.5" CornerRadius="20" Padding="18" Margin="10" MaxWidth="650">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Content="返回月历" Style="{DynamicResource Pill}" Click="CalendarCloseDay_Click"/>
                                <TextBlock x:Name="CalendarDayHeading" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="CalendarDayEntries"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Style="{StaticResource CalendarTaskChip}" Padding="12,10" Click="CalendarTask_Click" ToolTip="{Binding Hint}">
                                        <StackPanel><TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                                    </Button>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Border x:Name="SearchPage" Grid.Column="2" Visibility="Collapsed"
                    Background="{DynamicResource Card}" CornerRadius="24" Padding="24,21">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="找一找  ✿" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="任务名称、任务笔记和每日备忘，都能在这里找到" FontSize="12"
                                   Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,19,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{DynamicResource PaperInput}" KeyDown="SearchBox_KeyDown"
                                 ToolTip="输入关键词，按回车搜索"/>
                        <Button Grid.Column="2" Content="搜索" Style="{DynamicResource PrimaryPill}" Click="Search_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding SearchStatus}" Foreground="{DynamicResource Muted}"
                               FontSize="11" Margin="2,14,0,12"/>
                    <Grid Grid.Row="3">
                    <ListBox x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}"
                             SelectionChanged="SearchResults_SelectionChanged" ItemContainerStyle="{StaticResource TaskRow}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="550"/>
                                    <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource AccentOutline}" FontSize="10"
                                               Margin="10,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding DateLabel}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Snippet}" Foreground="#8E7E67"
                                           TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style><Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasSearchResults}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger></Style.Triggers>
                        </Style></StackPanel.Style>
                        <Border Width="74" Height="74" CornerRadius="26" Background="#E3F8F3"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Grid Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="21" Height="21" Margin="1,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Stroke="{DynamicResource Accent}" StrokeThickness="2.5"/>
                                <Path Data="M 22,22 L 30,30" Stroke="{DynamicResource Accent}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="想找哪件事？" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Ink}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="输入关键词，按回车试试看" FontSize="12" Foreground="{DynamicResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="CompletedPage" Grid.Column="2" Visibility="Collapsed"
                    Background="{DynamicResource Card}" CornerRadius="24" Padding="24,21">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="已完成  ✿" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                        <TextBlock Text="{Binding CompletedCountLabel}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20,0,14">
                        <RadioButton x:Name="AllCompletedFilter" Content="全部日期" GroupName="CompletedDates" IsChecked="True"
                                     Style="{StaticResource CompletedFilter}" Click="CompletedFilter_Click"/>
                        <RadioButton x:Name="TodayCompletedFilter" Content="今天" GroupName="CompletedDates"
                                     Style="{StaticResource CompletedFilter}" Click="CompletedFilter_Click"/>
                        <RadioButton x:Name="WeekCompletedFilter" Content="近 7 天" GroupName="CompletedDates"
                                     Style="{StaticResource CompletedFilter}" Click="CompletedFilter_Click"/>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CompletedGroups}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <StackPanel Margin="0,0,0,15">
                                        <Grid Margin="4,0,4,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DateLabel}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CountLabel}" FontSize="11" Foreground="{DynamicResource Muted}"
                                                       Margin="10,3,0,0"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Tasks}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <Border Background="{DynamicResource PaperSurface}" BorderBrush="#E5DCC7" BorderThickness="1.5"
                                                        CornerRadius="17" Padding="15,12" Margin="0,0,0,8">
                                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Border Width="24" Height="24" CornerRadius="8" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource AccentOutline}"
                                                                BorderThickness="1.5" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="✓" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="1,0,12,0">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                <TextBlock Text="原定 " FontSize="10" Foreground="{DynamicResource Muted}"/>
                                                                <TextBlock Text="{Binding Date, StringFormat={}{0:M月d日}}" FontSize="10" Foreground="{DynamicResource Muted}"/>
                                                                <TextBlock Text="{Binding Note}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="12,0,0,0"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="310"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="恢复待办" Style="{DynamicResource Pill}" FontSize="11" Padding="10,6"
                                                                VerticalAlignment="Center" Tag="{Binding}" Click="RestoreCompleted_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding HasCompletedTasks}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style></StackPanel.Style>
                            <Border Width="68" Height="68" Background="#DDF7F1" CornerRadius="23" HorizontalAlignment="Center" Margin="0,0,0,13">
                                <TextBlock Text="✓" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="这里还没有完成的任务" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center"/>
                            <TextBlock Text="勾选待办后，就会收在这里" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border x:Name="SettingsPage" Grid.Column="2" Visibility="Collapsed"
                    Background="{DynamicResource Card}" CornerRadius="24" Padding="25,24">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                    <TextBlock Text="小岛设置  ✿" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                    <TextBlock Text="让小岛按你的习惯运行" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,22"/>
                    <Border Background="{DynamicResource PaperSurface}" BorderBrush="#E5DCC7" BorderThickness="1.5" CornerRadius="18" Padding="18,16">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="开机后在后台提醒我" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                                <TextBlock Text="登录 Windows 后驻留托盘，不自动打开主窗口；随时可从托盘打开。"
                                           FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                            <CheckBox x:Name="AutostartCheck" Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0"
                                      Style="{StaticResource IslandCheck}" Click="AutostartCheck_Click" ToolTip="开机自启"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SettingsStatus" FontSize="11" Foreground="{DynamicResource Muted}" Margin="3,13,0,0"/>
                    <local:ScreenshotSettingsView x:Name="ScreenshotSettings" Margin="0,12,0,0"/>
                    <Button Content="专注时长与提醒设置" Click="FocusTab_Click" Style="{DynamicResource Pill}" HorizontalAlignment="Left" Margin="0,14,0,0"/>
                    <Border Background="{DynamicResource PaperSurface}" BorderBrush="#E5DCC7" BorderThickness="1.5" CornerRadius="18" Padding="18,16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="笔记图片" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Ink}"/>
                            <TextBlock x:Name="AttachmentUsageText" Text="按需保存，独立于截图箱" FontSize="12" Foreground="{DynamicResource TextInk}" Margin="0,9,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="正文、备份和找回副本引用的图片会保留。本次运行中用过的图片也会保留，方便撤销；重启后可再次检查。" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,12" TextWrapping="Wrap"/>
                            <WrapPanel>
                                <Button Content="刷新占用" Style="{DynamicResource Pill}" Click="RefreshAttachments_Click" Margin="0,0,8,0"/>
                                <Button x:Name="CleanAttachmentsButton" Content="清理未使用图片" Style="{DynamicResource Pill}" Click="CleanAttachments_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>
            <local:FocusPage x:Name="FocusView" Grid.Column="2" Visibility="Collapsed"/>
            <local:ScreenshotPage x:Name="ScreenshotGallery" Grid.Column="2" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
